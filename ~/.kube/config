apiVersion: v1
clusters:
- cluster:
    certificate-authority: ..\..\bin\k3s-cluster1-client.crt
    server: 'https://localhost:'
  name: k3s-cluster1
- cluster:
    certificate-authority: ..\..\bin\k3s-cluster2-client.crt
    server: 'https://localhost:'
  name: k3s-cluster2
contexts:
- context:
    cluster: k3s-cluster1
    user: admin@k3s-cluster1
  name: k3s-cluster1
- context:
    cluster: k3s-cluster2
    user: admin@k3s-cluster2
  name: k3s-cluster2
current-context: ""
kind: Config
users:
- name: admin@k3s-cluster1
  user:
    client-certificate: ..\..\bin\k3s-cluster1-client.crt
    client-key: ..\..\bin\k3s-cluster1-client.key
- name: admin@k3s-cluster2
  user:
    client-certificate: ..\..\bin\k3s-cluster2-client.crt
    client-key: ..\..\bin\k3s-cluster2-client.key
